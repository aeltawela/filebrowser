# syntax=docker/dockerfile:1

FROM alpine:3.23 AS ytdlp

# Fetch and verify the official, self-updatable release. Using remote ADD keeps
# the binary fresh when the image is rebuilt with an otherwise warm build cache.
ADD https://github.com/yt-dlp/yt-dlp/releases/latest/download/yt-dlp /yt-dlp
ADD https://github.com/yt-dlp/yt-dlp/releases/latest/download/SHA2-256SUMS /SHA2-256SUMS
RUN grep '  yt-dlp$' /SHA2-256SUMS | (cd / && sha256sum -c -) && \
  chmod 0755 /yt-dlp

FROM ghcr.io/linuxserver/baseimage-alpine:3.23

ENV PATH="/opt/filebrowser/bin:${PATH}"

# Alpine's yt-dlp package supplies Python, EJS, and JavaScript runtime support;
# the current official executable copied below supplies the yt-dlp application.
RUN apk update && \
  apk --no-cache add ca-certificates ffmpeg mailcap jq libcap yt-dlp

# Make user and create necessary directories
RUN mkdir -p /config /database /srv && \
  chown -R abc:abc /config /database /srv

# Copy files and set permissions
COPY filebrowser /bin/filebrowser
COPY docker/common/ /
COPY docker/s6/ /
COPY --from=ytdlp --chown=abc:abc --chmod=0755 /yt-dlp /opt/filebrowser/bin/yt-dlp

RUN chown -R abc:abc /opt/filebrowser/bin /bin/filebrowser /defaults healthcheck.sh && \
  setcap 'cap_net_bind_service=+ep' /bin/filebrowser

# Define healthcheck script
HEALTHCHECK --start-period=2s --interval=5s --timeout=3s CMD /healthcheck.sh

# Set the volumes and exposed ports
VOLUME /srv /config /database

EXPOSE 80
